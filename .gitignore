# Recon and build scratch — client site scrapes, extracted CSS, temp reports.
# These can contain client data; never commit them.
.recon/
*.recon.md
*.recon.json
tmp/
scratch/

# Generated client deliverables. Each build belongs in the client's own repo,
# not in the skill pack.
outputs/

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# Secrets — no API keys or WordPress application passwords in this repo, ever.
.env
.env.*
!.env.example
