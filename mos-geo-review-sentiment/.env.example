# Copy to the project's .env (or a .env outside this repo and pass --env-file). Never commit real keys.
# The scripts read the project .env first, then the environment, and never print a key.

# Required: Apify (console.apify.com > Settings > Integrations > API token)
APIFY_TOKEN=

# Optional: TypeSafe Jev for labelling (console.typesafe.ai/keys). Without it, Claude labels in session.
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Optional: keep author hashes stable across runs for one client (any random string).
# REVIEW_HASH_SALT=
