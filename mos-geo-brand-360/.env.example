# Copy to a .env OUTSIDE this repo (for example in your brain or project folder)
# and pass it with --env-file. Never commit real keys.

# https://openrouter.ai/keys  (needs credit on the account)
OPENROUTER_API_KEY=

# Bright Data > Account settings > API key  (5,000 free credits a month)
BRIGHTDATA_API_KEY=

# Optional: name of a SERP API zone, for Google AI Overviews
BRIGHTDATA_SERP_ZONE=
