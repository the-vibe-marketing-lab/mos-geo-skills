# Copy to a .env OUTSIDE this repo (for example in your brain or project folder)
# and pass it with --env-file. Never commit real keys.

# Primary: DataForSEO (app.dataforseo.com > API Access)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Fallback for the model answers: https://openrouter.ai/keys (needs credit)
OPENROUTER_API_KEY=

# Fallback for the consumer apps: Bright Data > Account settings > API key
BRIGHTDATA_API_KEY=
# Optional: a SERP API zone name, the fallback for Google AI Overviews
BRIGHTDATA_SERP_ZONE=
