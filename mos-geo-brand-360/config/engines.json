{
  "_comment": "Which AI surfaces mos-geo-brand-360 queries, and through which provider. DataForSEO is primary for everything. OpenRouter is the fallback for the models, tried when DataForSEO has no credentials or a call fails. The apps run on DataForSEO only; a failed app call is recorded as failed. Model names go stale: `brand360.py preflight` checks them against each provider's live model list. Set enabled=false to skip a surface.",

  "provider_order": {
    "models": ["dataforseo", "openrouter"],
    "apps": ["dataforseo"]
  },

  "models": [
    {
      "id": "chatgpt",
      "label": "ChatGPT (API)",
      "closed_book": true,
      "api_search": true,
      "enabled": true,
      "dataforseo": {"se": "chat_gpt", "model": "gpt-5.5", "country_field": true},
      "openrouter": {"model": "openai/gpt-chat-latest", "search": "native"}
    },
    {
      "id": "claude",
      "label": "Claude (API)",
      "closed_book": true,
      "api_search": true,
      "enabled": true,
      "dataforseo": {"se": "claude", "model": "claude-sonnet-5", "country_field": true},
      "openrouter": {"model": "~anthropic/claude-sonnet-latest", "search": "native"}
    },
    {
      "id": "gemini",
      "label": "Gemini (API)",
      "closed_book": true,
      "api_search": true,
      "enabled": true,
      "dataforseo": {"se": "gemini", "model": "gemini-3.8-flash", "country_field": false},
      "openrouter": {"model": "~google/gemini-flash-latest", "search": "native"}
    },
    {
      "id": "perplexity",
      "label": "Perplexity (Sonar API)",
      "closed_book": false,
      "api_search": true,
      "enabled": true,
      "_note": "Sonar always searches, so it sits out the closed-book pass and takes no web_search field.",
      "dataforseo": {"se": "perplexity", "model": "sonar", "country_field": true, "always_searches": true},
      "openrouter": {"model": "perplexity/sonar", "search": "builtin"}
    },
    {
      "id": "grok",
      "label": "Grok (API)",
      "closed_book": true,
      "api_search": true,
      "enabled": false,
      "_note": "Optional extra. DataForSEO has no Grok endpoint, so this runs on OpenRouter only.",
      "openrouter": {"model": "~x-ai/grok-latest", "search": "native"}
    }
  ],

  "apps": [
    {
      "id": "chatgpt-app",
      "label": "ChatGPT (app)",
      "enabled": true,
      "dataforseo": {"kind": "llm_scraper", "path": "ai_optimization/chat_gpt/llm_scraper/live/advanced"}
    },
    {
      "id": "gemini-app",
      "label": "Gemini (app)",
      "enabled": true,
      "dataforseo": {"kind": "llm_scraper", "path": "ai_optimization/gemini/llm_scraper/live/advanced"}
    },
    {
      "id": "aimode",
      "label": "Google AI Mode",
      "enabled": true,
      "dataforseo": {"kind": "serp", "path": "serp/google/ai_mode/live/advanced"}
    },
    {
      "id": "google-aio",
      "label": "Google AI Overviews",
      "enabled": true,
      "dataforseo": {"kind": "serp", "path": "serp/google/organic/live/advanced",
                     "extra": {"load_async_ai_overview": true, "depth": 10}}
    }
  ],

  "providers": {
    "dataforseo": {
      "_comment": "Verified live 2026-09-16. HTTP Basic auth with DATAFORSEO_LOGIN / DATAFORSEO_PASSWORD. user_prompt max 500 chars (LLM Responses); keyword max 2000 (LLM Scraper) and 700 (AI Mode).",
      "base_url": "https://api.dataforseo.com/v3/",
      "llm_responses_path": "ai_optimization/{se}/llm_responses/live",
      "models_path": "ai_optimization/{se}/llm_responses/models",
      "locations_path": "ai_optimization/chat_gpt/llm_scraper/locations",
      "language_code": "en",
      "max_output_tokens": 1200
    },
    "openrouter": {
      "base_url": "https://openrouter.ai/api/v1/chat/completions",
      "models_url": "https://openrouter.ai/api/v1/models",
      "max_tokens": 1200
    }
  }
}
