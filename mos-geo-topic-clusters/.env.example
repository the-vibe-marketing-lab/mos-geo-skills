# Copy to a .env OUTSIDE this repo (e.g. ~/.config/mos/keys.env) and pass it with --env-file.
# The scripts never print a value.
# Required for a real run: Jev. Create a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Embeddings (recall only), first key found wins: OpenAI first, then Voyage, then none.
OPENAI_API_KEY=
VOYAGE_API_KEY=
# Optional SERP-overlap stage (`serp`, off by default).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional: TYPESAFE_BASE_URL=https://api.typesafe.ai
